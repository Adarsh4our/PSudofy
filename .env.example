# ─── PSudofy Environment Configuration ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens or credentials!

# ─── Discord Bot ──────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ─── Navidrome Music Server ───────────────────────────────────────────────────
NAVIDROME_URL=http://localhost:4533
NAVI_USER=your_navidrome_username
NAVI_PASS=your_navidrome_password
NAVI_OWNER_ID=

# ─── Paths ────────────────────────────────────────────────────────────────────
MUSIC_FOLDER=./music
DB_PATH=./data/navidrome.db

# ─── Remote / SSH Configuration (for CLI sync) ────────────────────────────────
SSH_KEY_PATH=C:\path\to\your\ssh-key.key
SSH_HOST=ubuntu@your-server-ip
REMOTE_DIR=~/PSudofy

# ─── Optional Services & Tuning ───────────────────────────────────────────────
GENIUS_TOKEN=
LISTENBRAINZ_USER=
LISTENBRAINZ_TOKEN=
LASTFM_API_KEY=
WEEKLY_CHANNEL_ID=
WEB_DL_TOKEN=
WEB_DL_COOLDOWN_SECONDS=5
EXTERNAL_SERVER_URL=http://your-server-ip:5001
MAX_CONCURRENT_DOWNLOADS=2
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_PASS=
